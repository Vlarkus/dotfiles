#!/usr/bin/env bash
# Claude launcher TUI  (bound to `cl`)  — flicker-free, many options.
set -uo pipefail
export PATH="/usr/bin:/usr/local/bin:$HOME/.local/bin:$PATH"
CLAUDE="$(command -v claude || echo claude)"

# ---- colors ----
R=$'\e[0m'; HI=$'\e[1;36m'; DIM=$'\e[90m'; OK=$'\e[32m'; OFF=$'\e[90m'; YEL=$'\e[33m'
on_(){ [ "$1" = on ] && printf '%son%s' "$OK" "$R" || printf '%soff%s' "$OFF" "$R"; }
val(){ [ -n "$1" ] && printf '%s%s%s' "$HI" "$1" "$R" || printf '%s(none)%s' "$DIM" "$R"; }

# ---- screen control (no-flash) ----
enter(){ printf '\e[?1049h\e[?25l'; }          # alt screen, hide cursor
restore(){ printf '\e[?25h\e[?1049l'; }        # show cursor, leave alt screen
trap restore EXIT
launch(){ restore; exec "$CLAUDE" "$@"; }
home(){ printf '\e[H'; }
render(){ home; local l; for l in "$@"; do printf '%s\e[K\n' "$l"; done; printf '\e[J'; }
ask(){ printf '\e[?25h'; printf '\n  %s ' "$1"; IFS= read -r REPLY; printf '\e[?25l'; }
readkey(){ local k r; IFS= read -rsn1 k; [ "$k" = $'\e' ] && { IFS= read -rsn2 -t 0.005 r; k+="$r"; }; printf '%s' "$k"; }

# ---- new-session option state ----
MI=0; EI=0; PI=0; CONT=off; WT=off; IDE=off; BARE=off; DBG=off
NAME=""; ADDDIR=""; AGENT=""; SYSP=""
MODEL_NAMES=("Opus 4.8 (1M)" "Opus 4.8" "Sonnet" "Haiku" "Default")
MODEL_FLAGS=("opus[1m]"       "opus"     "sonnet" "haiku" "")
EFFORT=("default" "low" "medium" "high" "xhigh" "max")
PERM_NAMES=("skip / bypass" "default" "acceptEdits" "plan" "auto" "dontAsk")
PERM_MODE=("skip"           ""        "acceptEdits" "plan" "auto" "dontAsk")
cyc(){ local -n i=$1; i=$(( (i+1) % $2 )); }

new_screen(){
  local L
  while true; do
    L=(
      ""
      "  ${HI}New session${R}   key = change · ${HI}Enter${R} run · ${DIM}q${R} back"
      ""
      "  ${DIM}MODEL${R}"
      "   ${HI}[m]${R} model             ${HI}${MODEL_NAMES[$MI]}${R}"
      "   ${HI}[e]${R} effort            ${HI}${EFFORT[$EI]}${R}"
      "  ${DIM}PERMISSIONS${R}"
      "   ${HI}[p]${R} permission        ${HI}${PERM_NAMES[$PI]}${R}"
      "  ${DIM}SESSION${R}"
      "   ${HI}[n]${R} name              $(val "$NAME")"
      "   ${HI}[c]${R} continue last     $(on_ "$CONT")"
      "   ${HI}[a]${R} add dir           $(val "$ADDDIR")"
      "   ${HI}[g]${R} agent             $(val "$AGENT")"
      "  ${DIM}ADVANCED${R}"
      "   ${HI}[s]${R} append sys-prompt $(val "$SYSP")"
      "   ${HI}[w]${R} git worktree      $(on_ "$WT")"
      "   ${HI}[i]${R} connect IDE       $(on_ "$IDE")"
      "   ${HI}[b]${R} bare (minimal)    $(on_ "$BARE")"
      "   ${HI}[d]${R} debug             $(on_ "$DBG")"
      ""
    )
    render "${L[@]}"; printf '  %s>%s ' "$DIM" "$R"
    case "$(readkey)" in
      m) cyc MI ${#MODEL_NAMES[@]} ;;
      e) cyc EI ${#EFFORT[@]} ;;
      p) cyc PI ${#PERM_NAMES[@]} ;;
      c) [ "$CONT" = on ] && CONT=off || CONT=on ;;
      w) [ "$WT"  = on ] && WT=off  || WT=on ;;
      i) [ "$IDE" = on ] && IDE=off || IDE=on ;;
      b) [ "$BARE" = on ] && BARE=off || BARE=on ;;
      d) [ "$DBG" = on ] && DBG=off || DBG=on ;;
      n) ask "name:";        NAME="$REPLY" ;;
      a) ask "add dir:";     ADDDIR="$REPLY" ;;
      g) ask "agent:";       AGENT="$REPLY" ;;
      s) ask "append sys-prompt:"; SYSP="$REPLY" ;;
      '')
        local a=()
        [ -n "${MODEL_FLAGS[$MI]}" ] && a+=(--model "${MODEL_FLAGS[$MI]}")
        [ "${EFFORT[$EI]}" != default ] && a+=(--effort "${EFFORT[$EI]}")
        case "${PERM_MODE[$PI]}" in
          skip) a+=(--dangerously-skip-permissions) ;;
          "") ;;
          *) a+=(--permission-mode "${PERM_MODE[$PI]}") ;;
        esac
        [ -n "$NAME" ]   && a+=(--name "$NAME")
        [ "$CONT" = on ] && a+=(--continue)
        [ -n "$ADDDIR" ] && a+=(--add-dir "$ADDDIR")
        [ -n "$AGENT" ]  && a+=(--agent "$AGENT")
        [ -n "$SYSP" ]   && a+=(--append-system-prompt "$SYSP")
        [ "$WT"  = on ]  && a+=(--worktree)
        [ "$IDE" = on ]  && a+=(--ide)
        [ "$BARE" = on ] && a+=(--bare)
        [ "$DBG" = on ]  && a+=(--debug)
        launch "${a[@]}" ;;
      q|Q|$'\e') return ;;
    esac
  done
}

FORK=off
resume_screen(){
  mapfile -t ROWS < <(python3 - "$PWD" <<'PY'
import json, os, sys, glob, datetime
cwd = sys.argv[1]
hist = os.path.expanduser("~/.claude/history.jsonl")
pdir = os.path.expanduser("~/.claude/projects/" + "".join(c if c.isalnum() else "-" for c in cwd))
files = glob.glob(pdir + "/*.jsonl")
have = {os.path.basename(f)[:-6]: f for f in files}
firstmsg = {}
if os.path.exists(hist):
    for line in open(hist, encoding="utf-8", errors="ignore"):
        try: d = json.loads(line)
        except Exception: continue
        if d.get("project") != cwd: continue
        sid, disp = d.get("sessionId"), (d.get("display") or "").strip()
        if sid in have and sid not in firstmsg and disp and not disp.startswith("/"):
            firstmsg[sid] = " ".join(disp.split())
def title(path):
    custom = ai = None
    try:
        for line in open(path, encoding="utf-8", errors="ignore"):
            if '"type":"custom-title"' in line:
                try: custom = json.loads(line).get("customTitle")
                except Exception: pass
            elif '"type":"ai-title"' in line:
                try: ai = json.loads(line).get("aiTitle")
                except Exception: pass
    except Exception: pass
    return custom, ai
rows = []
for sid, path in have.items():
    mt = os.path.getmtime(path)
    custom, ai = title(path)
    label = custom or ai or firstmsg.get(sid) or "(untitled)"
    tag = "name" if custom else ("auto" if ai else "msg")
    rows.append((mt, sid, tag, " ".join(str(label).split())[:52]))
rows.sort(reverse=True)
for mt, sid, tag, label in rows:
    t = datetime.datetime.fromtimestamp(mt).strftime("%m-%d %H:%M")
    print(f"{sid}\t{t}\t{tag}\t{label}")
PY
)
  local n=${#ROWS[@]}
  [ "$n" -eq 0 ] && { render "" "  no sessions in this project."; sleep 1.2; return; }
  local sel=0 sid k L i t tag label
  while true; do
    L=( "" "  ${HI}Resume${R}  ${DIM}${PWD/#$HOME/\~}${R}   fork:$(on_ "$FORK")   ${DIM}j/k · number · Enter · f fork · q back${R}" "" )
    i=0
    for line in "${ROWS[@]}"; do
      IFS=$'\t' read -r sid t tag label <<<"$line"
      local badge; case "$tag" in name) badge="${OK}●${R}";; auto) badge="${YEL}○${R}";; *) badge="${DIM}·${R}";; esac
      if [ "$i" -eq "$sel" ]; then L+=("  ${HI}❯ $(printf '%2d' $((i+1)))${R} ${badge} ${DIM}${t}${R}  ${HI}${label}${R}")
      else                         L+=("    ${DIM}$(printf '%2d' $((i+1)))${R} ${badge} ${DIM}${t}${R}  ${label}"); fi
      i=$((i+1))
    done
    L+=( "" "  ${DIM}legend: ${OK}●${DIM} named  ${YEL}○${DIM} auto-title  ${DIM}· first message${R}" )
    render "${L[@]}"; printf '  %s>%s ' "$DIM" "$R"
    k="$(readkey)"
    case "$k" in
      j|J|$'\e[B') sel=$(( (sel+1) % n )) ;;
      k|K|$'\e[A') sel=$(( (sel-1+n) % n )) ;;
      f|F) [ "$FORK" = on ] && FORK=off || FORK=on ;;
      [1-9]) [ "$k" -le "$n" ] && { sel=$((k-1)); IFS=$'\t' read -r sid _ _ _ <<<"${ROWS[$sel]}"; a=(--resume "$sid"); [ "$FORK" = on ] && a+=(--fork-session); a+=(--dangerously-skip-permissions); launch "${a[@]}"; } ;;
      '') IFS=$'\t' read -r sid _ _ _ <<<"${ROWS[$sel]}"; a=(--resume "$sid"); [ "$FORK" = on ] && a+=(--fork-session); a+=(--dangerously-skip-permissions); launch "${a[@]}" ;;
      q|Q|$'\e') return ;;
    esac
  done
}

enter
while true; do
  render "" "  ${HI}claude launcher${R}  ${DIM}${PWD/#$HOME/\~}${R}" "" \
         "    ${HI}[N]${R}  new session" "    ${HI}[R]${R}  resume a session" "    ${HI}[q]${R}  quit" ""
  printf '  %s>%s ' "$DIM" "$R"
  case "$(readkey)" in
    n|N) new_screen ;;
    r|R) resume_screen ;;
    q|Q|$'\e') exit 0 ;;
  esac
done
